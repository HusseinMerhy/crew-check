# Copy of the settings the app reads, with the values left out.
# The real values live in Vercel (Settings -> Environment Variables), not in this repository.
# .env* is gitignored, so a local .env.local you make from this file never reaches GitHub.
# After changing any setting in Vercel: Deployments -> top row -> Redeploy.

# Pays for the AI. Required: without it every check returns an error.
# Get it from the Anthropic console. Never share it, never paste it into code or a commit.
ANTHROPIC_API_KEY=

# Which model answers. Optional: unset means claude-haiku-5-5.
# Only these three are accepted (see lib/model.js), so a typo cannot pick an expensive model:
#   claude-haiku-5-5, claude-sonnet-5-5, claude-opus-5-5
# The skill was scored 16/16 on Opus. A smaller model is cheaper but should be put through the
# 16 cases before it is trusted on real quotes.
CLAUDE_MODEL=

# The site lock (HTTP Basic, any username, this as the password).
# Optional, but unset means the site is open to anyone who finds the URL, and every check they
# run spends your API credit. Similar past jobs are internal data, so they are only shown on
# screen while this is set.
SITE_PASSCODE=

# The Neon Postgres connection string. Vercel adds this automatically when the database is
# attached to the project (Storage tab). Optional: without it the app still answers, but it falls
# back to keyword-only search, shows no similar past jobs, and logs nothing.
DATABASE_URL=

# The agentic retrieval experiment (lib/agentic.js). Optional: unset means off. "on" lets
# /api/check run it for requests that send mode "agentic", which only the eval runner does
# (node evals/run_eval.js <url> --agentic). The screen never sends it.
AGENTIC_RETRIEVAL=
